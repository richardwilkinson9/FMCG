    "test:e2e": "playwright test",
    "test:e2e:a11y": "playwright test --config a11y.config.ts",
    "test:e2e:visual": "playwright test --config visual.config.ts",
    "test:mutation": "stryker run",
    "audit:seo": "node scripts/seo-audit.mjs",
    "pentest:rls": "node scripts/rls-pentest.mjs",
    "gen:og": "node scripts/gen-og.mjs",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.0",
    "exceljs": "^4.4.0",
    "html-to-image": "^1.11.13",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "fast-check": "^4.9.0",
    "oxlint": "^1.71.0",
    "playwright": "^1.61.1",
    "subset-font": "^2.5.0",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.9"
  }
