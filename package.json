{
  "name": "fmcg",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vitest run && vite build && node scripts/prerender.mjs",
    "test": "vitest run",
